---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import GameFilters from '../components/GameFilters.astro';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
        <GameFilters categories={categories} publishers={publishers} />
        <p class="text-sm text-slate-400 mb-4" role="status" aria-live="polite" data-testid="filter-result-count"></p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
        <div id="no-matches" hidden>
          <EmptyState text="No games match your filters." />
        </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const count = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const noMatches = document.getElementById('no-matches');
  const publisherSelect = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');
  const checkboxes = Array.from(
    form?.querySelectorAll<HTMLInputElement>('input[name="category"]') ?? [],
  );

  function applyFilters(updateUrl: boolean): void {
    const categoryIds = checkboxes.filter((c) => c.checked).map((c) => c.value);
    const publisherId = publisherSelect?.value ?? '';
    let visible = 0;
    for (const card of cards) {
      const show =
        (categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '')) &&
        (publisherId === '' || card.dataset.publisherId === publisherId);
      card.hidden = !show;
      if (show) visible++;
    }
    if (noMatches) noMatches.hidden = visible > 0;
    if (count) {
      const filtered = categoryIds.length > 0 || publisherId !== '';
      count.textContent = filtered ? `${visible} of ${cards.length} games shown` : '';
    }
    if (updateUrl) {
      const params = new URLSearchParams();
      for (const id of categoryIds) params.append('category', id);
      if (publisherId) params.set('publisher', publisherId);
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }
  }

  if (form) {
    const params = new URLSearchParams(location.search);
    const selected = params.getAll('category');
    for (const box of checkboxes) box.checked = selected.includes(box.value);
    if (publisherSelect) publisherSelect.value = params.get('publisher') ?? '';
    applyFilters(false);

    form.addEventListener('change', () => applyFilters(true));
    form.addEventListener('submit', (event) => event.preventDefault());
    // Reset restores defaults after the event, so apply on the next tick.
    form.addEventListener('reset', () => setTimeout(() => applyFilters(true), 0));
    form.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        form.reset();
      }
    });
  }
</script>
