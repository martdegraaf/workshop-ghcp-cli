---
import type { Category, Publisher } from '../types/game';
import Button from './Button.astro';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
const focusRing = 'focus:ring-2 focus:ring-blue-500 focus:outline-none';
---

<form
    role="search"
    aria-label="Filter games"
    data-testid="game-filters"
    class="mb-8 p-4 bg-slate-800/60 rounded-xl border border-slate-700/50 flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
>
    <fieldset class="min-w-0">
        <legend class="text-sm font-medium text-slate-300 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
                <label
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-700/60 text-sm text-slate-100 cursor-pointer hover:bg-slate-700 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500"
                >
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class={`h-4 w-4 rounded border-slate-500 bg-slate-800 accent-blue-500 ${focusRing}`}
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-col gap-1">
        <label for="filter-publisher" class="text-sm font-medium text-slate-300">Publisher</label>
        <select
            id="filter-publisher"
            name="publisher"
            class={`rounded-lg bg-slate-700 text-slate-100 border border-slate-600 px-3 py-2 ${focusRing}`}
            data-testid="filter-publisher"
        >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
            ))}
        </select>
    </div>

    <Button type="reset" size="sm" data-testid="filter-clear">Clear filters</Button>
</form>
